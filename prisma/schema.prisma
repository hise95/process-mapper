// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  fullName   String
  role       String   @default("PROCESS_MANAGER")
  authSource String   @default("LOCAL") // "LOCAL" або "LDAP"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // Relations
  sessions         Session[]
  ownedProcesses   Process[] @relation("ProcessOwner")
  managedProcesses Process[] @relation("ProcessManager")
  historyLogs      ProcessHistoryLog[]
  adminLevels      ProcessLevel[] @relation("LevelAdmin")
  notifications    Notification[]
  feedbacks        Feedback[]
  authoredTasks    AnalystTask[] @relation("TaskAuthor")
  assignedTasks    AnalystTask[] @relation("TaskAssignee")
}

model ProcessLevel {
  id       String @id @default(cuid())
  name     String
  depth    Int    @default(1) // 1=L1, 2=L2, 3=L3
  parentId String?

  parent   ProcessLevel?  @relation("LevelHierarchy", fields: [parentId], references: [id])
  children ProcessLevel[] @relation("LevelHierarchy")

  processes Process[]

  adminId  String?
  admin    User?   @relation("LevelAdmin", fields: [adminId], references: [id])
}

model Process {
  id    String @id @default(cuid())
  code  String?
  title String

  processType String @default("MAIN")

  objective          String?
  input              String?
  output             String?
  participants       String?
  clients            String?
  inputSupplier      String?
  upstreamProcesses  String?
  downstreamProcesses String?

  bpmnUrl String?

  levelId   String?
  level     ProcessLevel? @relation(fields: [levelId], references: [id])
  ownerId   String?
  owner     User?         @relation("ProcessOwner", fields: [ownerId], references: [id])
  managerId String?
  manager   User?         @relation("ProcessManager", fields: [managerId], references: [id])

  version           Int           @default(1)
  status            String        @default("DRAFT")
  previousVersionId String?       @unique
  previousVersion   Process?      @relation("VersionChain", fields: [previousVersionId], references: [id])
  nextVersion       Process?      @relation("VersionChain")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  steps       ProcessStep[]
  kpis        ProcessKPI[]
  workflow    ApprovalWorkflow[]
  historyLogs ProcessHistoryLog[]
}

model ProcessStep {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  orderIndex       Int
  phase            String?
  name             String
  description      String?
  executorRole     String?
  participantsNote String?
  docUrl           String?
  comment          String?
}

model ProcessKPI {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  name        String
  unit        String?
  dataSource  String?
  frequency   String?
  targetValue String?
}

model ApprovalWorkflow {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  stage          String
  assignedToRole String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  comment        String?

  createdAt DateTime @default(now())
}

model ProcessHistoryLog {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  action    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comment   String?
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model ArchitectureDataStorage {
  id        String   @id @default("singleton")
  rev       Int      @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Feedback {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // 'BUG', 'SUGGESTION', etc.
  message      String
  status       String   @default("OPEN") // 'OPEN', 'RESOLVED'
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalystTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO") // "TODO", "IN_PROGRESS", "DONE"
  
  authorId    String
  author      User     @relation("TaskAuthor", fields: [authorId], references: [id])
  
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WikiPage {
  id        String   @id // 'bpmn', 'kpis', etc. (or cuid if custom)
  title     String
  icon      String   @default("FileText") // Name of lucide icon
  content   String   // HTML or Markdown or custom format
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  targetId  String?
  ip        String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([targetId])
}
