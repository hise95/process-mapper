// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}


// ─────────────────────────────────────────────
// DB-LEVEL ENUMS (prevent invalid values at storage layer)
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  PROCESS_ANALYST
  PROCESS_MANAGER
  PROCESS_OWNER
  EMPLOYEE
}

enum AuthSource {
  LOCAL
  LDAP
}

enum ProcessStatus {
  DRAFT
  PASSPORT_REVIEW_ANALYST
  PASSPORT_REVIEW_OWNER
  STEPS_DRAFT
  STEPS_REVIEW_ANALYST
  STEPS_REVIEW_OWNER
  KPIS_DRAFT
  KPIS_REVIEW_ANALYST
  KPIS_REVIEW_OWNER
  FINAL_APPROVAL_ANALYST
  APPROVED
  ARCHIVED
}

enum ProcessType {
  MAIN
  MANAGERIAL
  SERVICE
}

enum WorkflowStage {
  PASSPORT_ANALYST_REVIEW
  PASSPORT_OWNER_REVIEW
  STEPS_ANALYST_REVIEW
  STEPS_OWNER_REVIEW
  KPIS_ANALYST_REVIEW
  KPIS_OWNER_REVIEW
  FINAL_APPROVAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

enum FeedbackType {
  BUG
  SUGGESTION
  OTHER
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  fullName   String
  role       Role     @default(PROCESS_MANAGER)
  authSource AuthSource @default(LOCAL)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // Relations
  sessions         Session[]
  ownedProcesses   Process[] @relation("ProcessOwner")
  managedProcesses Process[] @relation("ProcessManager")
  historyLogs      ProcessHistoryLog[]
  adminLevels      ProcessLevel[] @relation("LevelAdmin")
  notifications    Notification[]
  feedbacks        Feedback[]
  authoredTasks    AnalystTask[] @relation("TaskAuthor")
  assignedTasks    AnalystTask[] @relation("TaskAssignee")
}

model ProcessLevel {
  id       String @id @default(cuid())
  name     String
  depth    Int    @default(1) // 1=L1, 2=L2, 3=L3
  parentId String?

  parent   ProcessLevel?  @relation("LevelHierarchy", fields: [parentId], references: [id])
  children ProcessLevel[] @relation("LevelHierarchy")

  processes Process[]

  adminId  String?
  admin    User?   @relation("LevelAdmin", fields: [adminId], references: [id])
}

model Process {
  id    String @id @default(cuid())
  code  String?
  title String

  processType ProcessType @default(MAIN)

  objective          String?
  input              String?
  output             String?
  participants       String?
  clients            String?
  inputSupplier      String?
  upstreamProcesses  String?
  downstreamProcesses String?

  bpmnUrl String?

  levelId   String?
  level     ProcessLevel? @relation(fields: [levelId], references: [id])
  ownerId   String?
  owner     User?         @relation("ProcessOwner", fields: [ownerId], references: [id])
  managerId String?
  manager   User?         @relation("ProcessManager", fields: [managerId], references: [id])

  version           Int           @default(1)
  status            ProcessStatus @default(DRAFT)
  previousVersionId String?       @unique
  previousVersion   Process?      @relation("VersionChain", fields: [previousVersionId], references: [id])
  nextVersion       Process?      @relation("VersionChain")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  steps       ProcessStep[]
  kpis        ProcessKPI[]
  workflow    ApprovalWorkflow[]
  historyLogs ProcessHistoryLog[]
}

model ProcessStep {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  orderIndex       Int
  phase            String?
  name             String
  description      String?
  executorRole     String?
  participantsNote String?
  docUrl           String?
  comment          String?
}

model ProcessKPI {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  name        String
  unit        String?
  dataSource  String?
  frequency   String?
  targetValue String?
}

model ApprovalWorkflow {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  stage          WorkflowStage
  assignedToRole Role
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  comment        String?

  createdAt DateTime @default(now())
}

model ProcessHistoryLog {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  action    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comment   String?
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model ArchitectureDataStorage {
  id        String   @id @default("singleton")
  rev       Int      @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Feedback {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         FeedbackType
  message      String
  status       FeedbackStatus @default(OPEN)
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalystTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  
  authorId    String
  author      User     @relation("TaskAuthor", fields: [authorId], references: [id])
  
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WikiPage {
  id        String   @id // 'bpmn', 'kpis', etc. (or cuid if custom)
  title     String
  icon      String   @default("FileText") // Name of lucide icon
  content   String   // HTML or Markdown or custom format
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  authenticatedAt DateTime @default(now()) // CWE-287: Відстеження часу останнього фактичного вводу пароля для Step-Up Auth
  ipAddress      String?
  userAgent      String?
  authMethod     AuthSource?

  @@index([userId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  targetId  String?
  ip        String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([targetId])
}
