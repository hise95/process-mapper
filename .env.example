# База даних (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/process_mapper"

# Налаштування LDAP / Active Directory (Опціонально)
# URL сервера Active Directory (ldap:// або ldaps://)
LDAP_URL="ldap://192.168.x.x" 

# База пошуку користувачів
LDAP_BASE_DN="dc=domain,dc=ua"

# Атрибут для логіну (зазвичай userPrincipalName або sAMAccountName)
LDAP_USERNAME_ATTRIBUTE="userPrincipalName"

# Додатковий фільтр пошуку (наприклад, для обмеження доступу певною групою)
LDAP_SEARCH_FILTER=
